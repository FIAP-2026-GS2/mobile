{
  "expo": {
    "name": "Smart Sampa Zeladoria",
    "slug": "smart-sampa-zeladoria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartsampazeladoria",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0E1A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.fiap.smartsampazeladoria"
    },
    "android": {
      "package": "br.com.fiap.smartsampazeladoria",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos a câmera para você fotografar o local e conferir se o conserto foi feito.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para confirmar que a foto foi tirada no local da ocorrência."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0b516c71-761e-45b7-baec-4aee0506e3ec"
      }
    },
    "owner": "johnny-mathias"
  }
}
